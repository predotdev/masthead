# Copy to .env and fill in. Never commit real values.

# For the CLI (import, push, studio). The Worker reads its settings from wrangler.toml
# and `wrangler secret put`: see Configuration in the README.

# pre.dev AI: one key for model listing, text, images, video and embeddings.
# Create it in the pre.dev dashboard under Integrations -> API Keys.
PREDEV_API_KEY=

# Only needed to import an existing Ghost site.
GHOST_ADMIN_URL=
GHOST_ADMIN_API_KEY=
